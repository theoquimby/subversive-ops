# Postgres connection (Neon on Vercel; pooled URL for the app)
DATABASE_URL="postgresql://user:password@host:5432/db"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/db"
# 32+ random characters — `openssl rand -base64 32`
SESSION_SECRET=""
BUSINESS_TIMEZONE="America/New_York"
# Square: Developer Dashboard → your app → Credentials (production access token)
SQUARE_ENVIRONMENT="production"
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
# Protects the scheduled endpoints under /api/cron (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""

# Claude (invoice reading, review replies, insights) — console.anthropic.com → API keys
ANTHROPIC_API_KEY=""
# Google reviews — Google Cloud console → APIs & Services → Credentials (Places API (New) enabled)
GOOGLE_PLACES_API_KEY=""

# Public address of the app, used for links in emails and notifications.
# Optional on Vercel (falls back to the production domain).
APP_URL="https://ops.example.com"

# Email (orders to suppliers, schedules, weekly brief) via Resend — resend.com → API keys.
# Verify your sending domain in Resend first. Leave blank and email features fall back to
# copy / download / your own mail app.
RESEND_API_KEY=""
# Sender shown to suppliers and staff; the domain must be verified in Resend.
EMAIL_FROM="Subversive Ops <ops@yourdomain.com>"

# Web push (free, no service): generate once with `npx web-push generate-vapid-keys`
# and keep them — changing them signs everyone out of notifications.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services: "mailto:you@yourdomain.com" or an https URL (not localhost — Apple rejects it).
# Defaults to the EMAIL_FROM address.
VAPID_SUBJECT="mailto:ops@yourdomain.com"

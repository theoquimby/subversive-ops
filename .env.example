# Postgres connection (Neon on Vercel; pooled URL for the app)
DATABASE_URL="postgresql://user:password@host:5432/db"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/db"
# 32+ random characters — `openssl rand -base64 32`
SESSION_SECRET=""
BUSINESS_TIMEZONE="America/New_York"
# ---------------------------------------------------------------------------------------------
# Outside services. ALL OPTIONAL HERE: a manager can paste every key below in the app under
# Settings → Connections (step-by-step guides with pictures). Pasted keys are stored encrypted in
# the database and take priority; these environment variables are only a fallback.
# ---------------------------------------------------------------------------------------------

# Square — see "Connecting Square" in the README.
# "production" or "sandbox". Ignored when an Application ID is saved in the app (a sandbox- ID means sandbox).
SQUARE_ENVIRONMENT="production"
# The Square app's credentials for "Connect with Square" (Connections → Square, Part 1).
# Redirect URL to register with Square: https://<your-domain>/api/square/oauth/callback
SQUARE_APPLICATION_ID=""
SQUARE_APPLICATION_SECRET=""
# Instant updates (optional, Connections → Square): the webhook subscription's Signature key.
SQUARE_WEBHOOK_SIGNATURE_KEY=""
# Optional override for the webhook URL Square signs. Default: https://<APP_URL>/api/webhooks/square
# (or the request's own address), which is what the Connections guide shows.
SQUARE_WEBHOOK_URL=""
# Legacy fallback, used only when nothing is connected in the app: a production access token
# (Credentials page) and a location id.
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""

# Protects the scheduled jobs under /api/cron (Vercel Cron sends it as a Bearer token).
# Required: without it every cron answers 401 and nothing runs on schedule.
CRON_SECRET=""

# Optional — or Connections → AI features. Claude (invoice reading, review replies, Ask).
ANTHROPIC_API_KEY=""
# Optional — or Connections → Google reviews (which also finds your business, so no Place ID needed).
# Google Cloud → APIs & Services → Credentials, with Places API (New) enabled.
GOOGLE_PLACES_API_KEY=""

# Public address of the app, used for links in emails and notifications, and for the Square
# redirect/webhook addresses shown in Connections.
# Optional on Vercel (falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, which Vercel sets).
APP_URL="https://ops.example.com"

# Optional — or Connections → Email. Email (orders to suppliers, schedules, weekly brief) via
# Resend — resend.com → API keys. Verify your sending domain in Resend first. Leave blank and
# email features fall back to copy / download / your own mail app.
RESEND_API_KEY=""
# Sender shown to suppliers and staff; the domain must be verified in Resend.
EMAIL_FROM="Subversive Ops <ops@yourdomain.com>"

# Optional — or one tap in Connections → Phone notifications, which generates and stores them.
# Web push (free, no service): generate once with `npx web-push generate-vapid-keys`
# and keep them — changing them signs everyone out of notifications.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services: "mailto:you@yourdomain.com" or an https URL (not localhost — Apple rejects it).
# Defaults to the EMAIL_FROM address.
VAPID_SUBJECT="mailto:ops@yourdomain.com"

# Seeding (only for `npm run db:seed`, which WIPES the database):
# SEED_MODE="empty"      # just the logins, no demo data
# SEED_MANAGER_PIN=""    # override the demo PINs (1234 / 0000) on anything reachable online
# SEED_STAFF_PIN=""

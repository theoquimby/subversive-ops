// Subversive Ops — internal kitchen ops (costing, ordering, counts).
//
// Design rules that keep costs "live" while preserving history:
//   * Prices are NEVER overwritten. Each change is a new PriceRecord with an
//     effectiveDate. "Current cost" = latest record; "cost on date X" = latest
//     record on or before X. This replaces the old "add another tab" approach.
//   * Every quantity is stored in the ingredient's base unit (g, ml or each).
//     Recipes can use any unit; it's converted at calculation time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // pooled, for the app
  directUrl = env("DATABASE_URL_UNPOOLED") // direct, for migrations
}

enum Role {
  MANAGER
  STAFF
}

enum BaseUnit {
  g
  ml
  each
}

enum SupplierKind {
  DISTRIBUTOR // sends a downloadable price sheet
  LOCAL // bakery, butcher, etc. — prices entered by hand
}

enum PriceSource {
  IMPORT
  MANUAL
  SCRAPE
}

enum RecipeKind {
  MENU // sold item (maps to a Square item variation)
  PREP // sauce, dough, batch — used inside other recipes
  MODIFIER // add-on like "add bacon" (maps to a Square modifier)
}

enum OrderStatus {
  DRAFT
  SENT
  RECEIVED
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  pinHash   String
  role      Role     @default(STAFF)
  active    Boolean  @default(true)
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?
  createdAt DateTime @default(now())
  counts    StockCount[]
  feedbackGiven EmployeeFeedback[]
}

model Setting {
  key   String @id
  value String
}

model Supplier {
  id            String         @id @default(cuid())
  name          String         @unique
  kind          SupplierKind   @default(DISTRIBUTOR)
  email         String?
  // Days of week the supplier delivers, 0=Sun..6=Sat
  deliveryDays  Int[]          @default([])
  leadTimeDays  Int            @default(1)
  minOrder      Decimal?       @db.Decimal(10, 2)
  // Remembered column mapping for this supplier's price sheet
  importMapping Json?
  notes         String?
  active        Boolean        @default(true)
  /// "kitchen" or "brewery": which ordering screen it belongs to
  department    String         @default("kitchen")
  /// "regular": an order every delivery (nag when none is placed); "as_needed": only when counts and sales say stock runs short
  orderCadence  String         @default("regular")
  products      SupplierProduct[]
  imports       PriceImport[]
  orders        PurchaseOrder[]
  invoices      Invoice[]
}

model Ingredient {
  id          String       @id @default(cuid())
  name        String       @unique
  category    String       @default("Other")
  storageArea String       @default("Dry storage")
  baseUnit    BaseUnit
  // Usable fraction after trim/cook loss (e.g. 0.85). Cost is divided by this.
  yieldPct    Decimal      @default(1) @db.Decimal(5, 4)
  // Extra buffer when ordering, as a fraction of forecast usage
  safetyPct   Decimal      @default(0.15) @db.Decimal(5, 4)
  // Unit staff count in (e.g. "case", "lb", "each"); defaults to base unit
  countUnit   String?
  // Which product we normally buy this ingredient as
  preferredProductId String? @unique
  preferredProduct   SupplierProduct? @relation("Preferred", fields: [preferredProductId], references: [id], onDelete: SetNull)
  active      Boolean      @default(true)
  notes       String?
  products    SupplierProduct[]
  conversions UnitConversion[]
  recipeLines RecipeLine[]
  countLines  StockCountLine[]
  wasteLogs   WasteLog[]
  /// Major US allergens this ingredient contains (see src/domain/allergens.ts ALLERGENS).
  allergens   String[]     @default([])
  /// Count setup (managers): "how to count this" note shown to whoever counts.
  countNote   String?
  /// Shelf order within the storage area on the count sheet (lower first; null = after, by name).
  countOrder  Int?
  /// More home areas it's listed in on counts, besides storageArea (opened ones in the walk-in, full ones on the shelf).
  countAreas  String[]     @default([])
  /// Units staff may count in. Empty = every unit the item can be measured in.
  countUnits  String[]     @default([])
  /// How often it's counted: "every" count (default), "monthly" (due 30+ days after the last count) or "changes" (only when someone adds it; the last count carries forward).
  countEvery  String       @default("every")
  /// When the photo was last set (cache-busts the image URL); null = no photo.
  photoAt     DateTime?
  photo       CountPhoto?
  brewLines   BrewRecipeLine[]
  brewStock   BrewStockMove[]
  /// "kitchen" or "brewery" (malt, hops, yeast and other brewing ingredients)
  department  String       @default("kitchen")
}

/// One photo per count item (an ingredient or a prep recipe), shown on the count sheet. Compressed in the browser first.
model CountPhoto {
  id           String      @id @default(cuid())
  ingredientId String?     @unique
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  recipeId     String?     @unique
  recipe       Recipe?     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  mime         String
  bytes        Bytes
  updatedAt    DateTime    @updatedAt
}

/// Containers a prep item is counted in: "1/3 pan" = 30 each.
model RecipeCountUnit {
  id       String  @id @default(cuid())
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  unit     String
  baseQty  Decimal @db.Decimal(14, 4)

  @@unique([recipeId, unit])
}

/// A prep item (house-made sauce, portioned protein) counted on an inventory count. Approving the count records it as the prep list's on-hand.
model StockCountPrepLine {
  id       String     @id @default(cuid())
  countId  String
  count    StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  qtyBase  Decimal    @db.Decimal(14, 4)
  parts    Json?

  @@unique([countId, recipeId])
  @@index([recipeId])
}

// Ingredient-specific units: "1 slice = 21 g", "1 cup = 120 g" (flour), "1 bun = 1 each"
model UnitConversion {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unit         String
  baseQty      Decimal    @db.Decimal(14, 4)

  @@unique([ingredientId, unit])
}

// A specific thing a supplier sells, e.g. "Heinz Ketchup 6/#10 can, SKU 123".
model SupplierProduct {
  id           String      @id @default(cuid())
  supplierId   String
  supplier     Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  preferredFor Ingredient? @relation("Preferred")
  sku          String
  description  String
  packText     String?     // as printed on the sheet, e.g. "6/#10"
  purchaseUnit String      @default("case")
  // How much of the ingredient's base unit one purchase unit contains
  packQtyBase  Decimal?    @db.Decimal(14, 4)
  url          String?     // supplier web page, for future price checks
  active       Boolean     @default(true)
  prices       PriceRecord[]
  orderLines   PurchaseOrderLine[]
  invoiceLines InvoiceLine[]

  @@unique([supplierId, sku])
  @@index([ingredientId]) // perf
}

model PriceRecord {
  id                String          @id @default(cuid())
  supplierProductId String
  product           SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  price             Decimal         @db.Decimal(10, 2) // per purchase unit
  effectiveDate     DateTime        @db.Date
  source            PriceSource
  importId          String?
  import            PriceImport?    @relation(fields: [importId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())

  @@index([supplierProductId, effectiveDate])
}

model PriceImport {
  id            String        @id @default(cuid())
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  filename      String
  effectiveDate DateTime      @db.Date
  rowCount      Int
  newProducts   Int
  priceChanges  Int
  createdAt     DateTime      @default(now())
  prices        PriceRecord[]
}

model Recipe {
  id         String      @id @default(cuid())
  name       String      @unique
  kind       RecipeKind  @default(MENU)
  category   String      @default("Food")
  menuPrice  Decimal?    @db.Decimal(10, 2)
  // For PREP recipes: what one batch yields, e.g. 2000 ml of aioli
  yieldQty   Decimal     @default(1) @db.Decimal(14, 4)
  yieldUnit  String      @default("each")
  // Base unit the yield converts to (prep recipes act like an ingredient)
  yieldBase  BaseUnit    @default(each)
  targetFoodCostPct Decimal? @db.Decimal(5, 4)
  active     Boolean     @default(true)
  notes      String?
  lines      RecipeLine[] @relation("RecipeLines")
  usedIn     RecipeLine[] @relation("SubRecipe")
  squareMaps SquareMapping[]
  wasteLogs  WasteLog[]
  /// Prep items on the inventory count: the storage area they're counted in (null = not on the count).
  countArea   String?
  /// More home areas it's listed in on counts.
  countAreas  String[]     @default([])
  countOrder  Int?
  countNote   String?
  countUnit   String?
  countUnits  String[]     @default([])
  countEvery  String       @default("every")
  photoAt     DateTime?
  photo       CountPhoto?
  countUnitList RecipeCountUnit[]
  countLines  StockCountPrepLine[]
}

model RecipeLine {
  id           String      @id @default(cuid())
  recipeId     String
  recipe       Recipe      @relation("RecipeLines", fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  subRecipeId  String?
  subRecipe    Recipe?     @relation("SubRecipe", fields: [subRecipeId], references: [id], onDelete: Restrict)
  qty          Decimal     @db.Decimal(14, 4)
  unit         String
  sort         Int         @default(0)

  @@index([recipeId]) // perf: lines are loaded per recipe
  @@index([subRecipeId])
  @@index([ingredientId])
}

// Links a Square catalog object (item variation or modifier) to a recipe.
model SquareMapping {
  squareId   String  @id
  squareName String
  squareType String  // ITEM_VARIATION | MODIFIER
  recipeId   String?
  recipe     Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  ignored    Boolean @default(false) // e.g. gift cards, merch
  /// Bought in, no recipe (cans, soda, merch): what one sold costs us. Counts as linked at this cost.
  unitCost   Decimal? @db.Decimal(10, 2)
  /// Revenue class for a bought-in item ("food" | "beer" | "otherBev" | "retail"); null = by its Square category.
  costClass  String?

  @@index([recipeId]) // perf
}

// Daily sales per Square object (variation or modifier) — aggregated from orders.
model DailySale {
  date      DateTime @db.Date
  squareId  String
  name      String
  qty       Decimal  @db.Decimal(12, 3)
  netSales  Decimal  @db.Decimal(12, 2)

  @@id([date, squareId])
  @@index([squareId])
}

model StockCount {
  id        String   @id @default(cuid())
  takenAt   DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  area      String?
  completed Boolean  @default(false)
  /// Staff finished counting; waiting for a manager to approve (completed stays false until then).
  submittedAt DateTime?
  approvedAt  DateTime?
  approvedBy  String?
  /// "Something's missing?" notes from whoever counted, for the manager.
  staffNote   String?
  lines     StockCountLine[]
  prepLines StockCountPrepLine[]

  @@index([completed, takenAt]) // perf: latest completed counts
}

model StockCountLine {
  id           String     @id @default(cuid())
  countId      String
  count        StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qtyBase      Decimal    @db.Decimal(14, 4)
  /// What was typed, per area, when it was counted in more than one unit or place, e.g. [{"area":"Walk-in","qty":2,"unit":"jug"},{"area":"Dry storage","qty":3,"unit":"can"}]. qtyBase is the total.
  parts        Json?

  @@unique([countId, ingredientId])
  @@index([ingredientId]) // perf: last count per ingredient
}

model WasteLog {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qtyBase      Decimal    @db.Decimal(14, 4)
  reason       String
  loggedBy     String?
  loggedAt     DateTime   @default(now())
  /// Set when the waste was a prepped or menu item, exploded into one row per ingredient.
  sourceRecipeId String?
  sourceRecipe   Recipe?  @relation(fields: [sourceRecipeId], references: [id], onDelete: SetNull)
  sourceQty      Decimal? @db.Decimal(12, 3)
  sourceUnit     String?
  /// Rows exploded from one entry share a batch id (undo removes them together).
  batchId        String?

  @@index([batchId])
  @@index([loggedAt])
  @@index([ingredientId]) // perf
}

model PurchaseOrder {
  id           String      @id @default(cuid())
  supplierId   String
  supplier     Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status       OrderStatus @default(DRAFT)
  deliveryDate DateTime    @db.Date
  coverUntil   DateTime    @db.Date
  createdAt    DateTime    @default(now())
  sentAt       DateTime?
  receivedAt   DateTime?
  notes        String?
  lines        PurchaseOrderLine[]
  invoices     Invoice[]

  @@index([status, deliveryDate]) // perf: open orders, incoming stock
  @@index([supplierId])
}

model PurchaseOrderLine {
  id                String          @id @default(cuid())
  orderId           String
  order             PurchaseOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierProductId String
  product           SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  suggestedQty      Decimal         @db.Decimal(10, 2)
  qty               Decimal         @db.Decimal(10, 2)
  unitPrice         Decimal?        @db.Decimal(10, 2)
  receivedQty       Decimal?        @db.Decimal(10, 2)

  @@index([orderId]) // perf
  @@index([supplierProductId])
}

// ---------------------------------------------------------------------------
// Labor & scheduling
// ---------------------------------------------------------------------------

model Position {
  id         String   @id @default(cuid())
  name       String   @unique
  color      String   @default("#64748b")
  area       String   @default("FOH") // FOH | BOH | BAR
  defaultRate Decimal? @db.Decimal(8, 2)
  tipPoints  Decimal  @default(1) @db.Decimal(5, 2)
  tipEligible Boolean @default(true)
  sort       Int      @default(0)
  // Staffing: one person per $salesPerHour of forecast sales, within min/max.
  salesPerHour Decimal? @db.Decimal(8, 2)
  minStaff   Int      @default(0)
  maxStaff   Int      @default(3)
  employees  EmployeePosition[]
  shifts     Shift[]
  timecards  Timecard[]
}

model Employee {
  id                 String   @id @default(cuid())
  name               String
  email              String?
  phone              String?
  userId             String?  @unique
  squareTeamMemberId String?  @unique
  hourlyRate         Decimal? @db.Decimal(8, 2)
  isMinor            Boolean  @default(false)
  maxHoursWeek       Int?
  /// { "0": [["16:00","22:00"]], ... } weekday → available windows; missing day = unavailable
  availability       Json?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  positions          EmployeePosition[]
  shifts             Shift[]
  timecards          Timecard[]
  timeOff            TimeOffRequest[]
  swapsRequested     ShiftSwap[] @relation("SwapRequester")
  swapsTaken         ShiftSwap[] @relation("SwapTaker")
  tips               TipAllocation[]
  payAdjustments     PayAdjustment[]
  feedback           EmployeeFeedback[]
  documentAcks       DocumentAck[]
  certifications     Certification[]
  trainingAssignments TrainingAssignment[]
  /// First day of work (anniversaries, "first month"). Null = use createdAt.
  startDate           DateTime?            @db.Date
  /// Who to call in an emergency. Collected on the new-hire checklist; never tax or bank details.
  emergencyName       String?
  emergencyPhone      String?
  emergencyRelation   String?
  onboardings         Onboarding[]
  shoutouts           Shoutout[]
  redemptions         RewardRedemption[]
  staffMessages       StaffMessage[]
}

model EmployeePosition {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  rate       Decimal? @db.Decimal(8, 2)

  @@id([employeeId, positionId])
}

model Shift {
  id           String    @id @default(cuid())
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  positionId   String
  position     Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  start        DateTime
  end          DateTime
  breakMinutes Int       @default(0)
  published    Boolean   @default(false)
  notes        String?
  createdAt    DateTime  @default(now())
  swaps        ShiftSwap[] @relation("SwapShift")
  /// Swaps where this shift is the one given back in a trade.
  swapOffers   ShiftSwap[] @relation("SwapOffered")

  @@index([start])
  @@index([employeeId, start]) // perf
}

enum TimecardSource {
  SQUARE
  MANUAL
}

model Timecard {
  id           String         @id @default(cuid())
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  positionId   String?
  position     Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  clockIn      DateTime
  clockOut     DateTime?
  breakMinutes Int            @default(0)
  hourlyRate   Decimal?       @db.Decimal(8, 2)
  source       TimecardSource @default(MANUAL)
  squareId     String?        @unique
  /// Set when a manager changes the card in Ops; the Square sync must not overwrite it.
  manuallyEdited Boolean      @default(false)
  /// Set when the pay period/week is approved; approved cards are read-only until unlocked.
  approvedAt   DateTime?
  approvedBy   String?

  @@index([clockIn])
  @@index([employeeId, clockIn]) // perf
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum TimeOffType {
  PTO
  SICK
  UNPAID
}

model TimeOffRequest {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  DateTime      @db.Date
  endDate    DateTime      @db.Date
  type       TimeOffType   @default(UNPAID)
  /// Paid hours to draw from a balance (SICK/PTO). Null = work it out from scheduled shifts.
  hours      Decimal?      @db.Decimal(6, 2)
  note       String?
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  @@index([status]) // perf: pending requests
}

/// A shift changing hands. kind GIVE: give it away; SWAP: trade for one of the taker's shifts;
/// DROP: can't work it, becomes an open shift once approved; PICKUP: an open shift someone claimed.
/// takerId set with claimedAt null = the requester asked that person, who hasn't said yes yet.
model ShiftSwap {
  id          String        @id @default(cuid())
  shiftId     String
  shift          Shift         @relation("SwapShift", fields: [shiftId], references: [id], onDelete: Cascade)
  requesterId String
  requester   Employee      @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  takerId     String?
  taker       Employee?     @relation("SwapTaker", fields: [takerId], references: [id], onDelete: SetNull)
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  kind           String        @default("GIVE") // GIVE | SWAP | DROP | PICKUP
  /// SWAP: the taker's shift the requester gets in return.
  offeredShiftId String?
  offeredShift   Shift?        @relation("SwapOffered", fields: [offeredShiftId], references: [id], onDelete: SetNull)
  note           String?
  claimedAt      DateTime?
  decidedAt      DateTime?
  decidedBy      String?
  autoApproved   Boolean       @default(false)
  /// [{ at, by, what }] — every step, for the history.
  log            Json          @default("[]")

  @@index([status]) // perf: pending swaps
  @@index([shiftId])
}

model TipPeriod {
  id          String   @id @default(cuid())
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  totalTips   Decimal  @db.Decimal(10, 2)
  method      String   // HOURS | POINTS
  createdAt   DateTime @default(now())
  finalized   Boolean  @default(false)
  allocations TipAllocation[]
  /// POOL: card tips all go into the pool. KEEP: each person in the pool keeps the card tips Square credits to them; the rest is pooled.
  cardMode    String   @default("POOL")
  /// POOL: declared cash tips go into the pool. KEEP: each person in the pool keeps the cash they declared.
  cashMode    String   @default("POOL")
  /// Card tips and cash tips in totalTips (null on periods saved before tips came from Square).
  cardTips    Decimal? @db.Decimal(10, 2)
  cashTips    Decimal? @db.Decimal(10, 2)
  /// Values typed over Square's: { card: {employeeId: $}, cash: {employeeId: $}, pooledCard?: $, pooledCash?: $ }. The Square sync never touches these.
  overrides   Json?
  /// The tip lines (Square + manual) as they were at the last save, so a finalized period never changes.
  snapshot    Json?
}

model TipAllocation {
  id         String    @id @default(cuid())
  periodId   String
  period     TipPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hours      Decimal   @db.Decimal(8, 2)
  points     Decimal   @db.Decimal(10, 2)
  amount     Decimal   @db.Decimal(10, 2)
  /// Of amount: card tips (paid through payroll) and cash tips (handed out or already in hand).
  cardAmount Decimal?  @db.Decimal(10, 2)
  cashAmount Decimal?  @db.Decimal(10, 2)
}

/// Tips Square reports per business day, rebuilt by every sync of that day.
/// CARD: Payment.tip_money by Payment.team_member_id (the person who took the payment).
/// CASH: Timecard.declared_cash_tip_money by the timecard's team member.
/// teamMemberId "" holds tips not linked to anyone; it is written for every synced day, so it also marks the day as synced.
model SquareTip {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  kind         String   // CARD | CASH
  teamMemberId String   @default("")
  amount       Decimal  @db.Decimal(10, 2)
  /// Payments (CARD) or timecards (CASH) behind the amount.
  count        Int      @default(0)
  syncedAt     DateTime @default(now())

  @@unique([date, kind, teamMemberId])
  @@index([date])
}

/// One-off pay lines (bonus, correction, deduction, reimbursement) on a business date.
model PayAdjustment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  kind       String   @default("BONUS") // BONUS | CORRECTION | DEDUCTION | REIMBURSEMENT
  /// Signed dollars; deductions are stored negative.
  amount     Decimal  @db.Decimal(10, 2)
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([date])
}

enum PayPeriodStatus {
  OPEN
  APPROVED
}

/// A pay period. Approving it locks its timecards and stores the payroll rows as they were.
model PayPeriod {
  id         String          @id @default(cuid())
  startDate  DateTime        @db.Date
  endDate    DateTime        @db.Date
  status     PayPeriodStatus @default(OPEN)
  approvedBy String?
  approvedAt DateTime?
  /// Payroll rows + totals at approval time (see domain/payroll.ts PayrollSnapshot).
  snapshot   Json?
  createdAt  DateTime        @default(now())
  /// Marked as entered in the payroll provider (Square Payroll, Gusto…). Ops never runs payroll.
  handedOffAt DateTime?
  handedOffBy String?

  @@unique([startDate, endDate])
}

/// Manager → team notes shown on My shifts.
model Announcement {
  id        String    @id @default(cuid())
  body      String
  author    String?
  pinned    Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Demand signals
// ---------------------------------------------------------------------------

/// Whole-store sales by hour (business-local hour 0–23), for hourly forecasts and labor.
model HourlySale {
  date     DateTime @db.Date
  hour     Int
  netSales Decimal  @db.Decimal(12, 2)
  orders   Int

  @@id([date, hour])
}

model Event {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  title     String
  kind      String   @default("OTHER") // GAME | FESTIVAL | MUSIC | PRIVATE | CLOSURE | HOLIDAY | OTHER
  startTime String?  // "19:30"
  endTime   String?
  /// Expected demand multiplier for the day (1.3 = +30%). Learned values can overwrite it.
  impact    Decimal  @default(1) @db.Decimal(5, 3)
  notes     String?
  createdAt DateTime @default(now())
  /// Bumped on every edit (the website feed sends it as updatedAt)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([date])
}

model WeatherDay {
  date      DateTime @id @db.Date
  tempMaxC  Decimal  @db.Decimal(5, 1)
  tempMinC  Decimal  @db.Decimal(5, 1)
  precipMm  Decimal  @db.Decimal(6, 1)
  code      Int
  forecast  Boolean  @default(true)
  fetchedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Invoices
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  NEEDS_REVIEW
  MATCHED
  PRICE_ISSUE
  QTY_ISSUE
  PRICE_AND_QTY
  APPROVED
}

model Invoice {
  id            String        @id @default(cuid())
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  orderId       String?
  order         PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoiceNumber String?
  invoiceDate   DateTime      @db.Date
  total         Decimal?      @db.Decimal(10, 2)
  status        InvoiceStatus @default(NEEDS_REVIEW)
  image         Bytes?
  imageType     String?
  extractedBy   String?       // "claude" | "manual"
  approvedBy    String?
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  lines         InvoiceLine[]
  /// "invoice" (a supplier's bill) or "receipt" (a store run: Price Chopper, Restaurant Depot…)
  kind          String        @default("invoice")
  dueDate       DateTime?     @db.Date
  /// Receipts: how it was paid, as printed ("cash", "card", "Visa 1234")
  paymentMethod String?
  /// Pages 2, 3… of a multi-page invoice (page 1 stays in `image`).
  pages         InvoicePage[]

  @@unique([supplierId, invoiceNumber])
  @@index([status]) // perf: open invoices on the Overview and brief
  @@index([orderId])
}

/// Extra pages of an invoice photo set (page 1 is Invoice.image). Bytes in Postgres, ≤ 8 MB each.
model InvoicePage {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// 2, 3, … in reading order
  position  Int
  bytes     Bytes
  type      String
  createdAt DateTime @default(now())

  @@index([invoiceId, position])
}

/// Links between records here and a QuickBooks Online company (Supplier ↔ Vendor,
/// Invoice ↔ Bill), so sending again updates instead of duplicating. Keyed by
/// the QuickBooks company (realmId): connecting a different company starts fresh.
model QuickBooksLink {
  id           String    @id @default(cuid())
  realmId      String
  /// "vendor" (localId = Supplier.id) | "bill" (localId = Invoice.id)
  kind         String
  localId      String
  qboId        String?
  syncToken    String?
  /// The invoice photo/PDF attached to the bill (uploaded once).
  attachableId String?
  /// Fingerprint of what was last sent, so an unchanged invoice isn't re-sent.
  hash         String?
  /// "ok" | "sending" | "error"
  status       String    @default("ok")
  /// The bill was already in QuickBooks (typed in by hand): linked, never changed by the app.
  manual       Boolean   @default(false)
  error        String?
  sentAt       DateTime?
  sentBy       String?
  updatedAt    DateTime  @updatedAt

  @@unique([realmId, kind, localId])
  @@index([kind, localId])
}

model InvoiceLine {
  id                String           @id @default(cuid())
  invoiceId         String
  invoice           Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  supplierProductId String?
  product           SupplierProduct? @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  sku               String?
  description       String
  qty               Decimal          @db.Decimal(10, 2)
  unitPrice         Decimal          @db.Decimal(10, 2)
  expectedQty       Decimal?         @db.Decimal(10, 2)
  expectedPrice     Decimal?         @db.Decimal(10, 2)
  status            String           @default("OK") // OK | PRICE | QTY | PRICE_QTY | UNMATCHED
  /// item | fee | deposit | tax | credit — only items are matched to products and priced
  kind              String           @default("item")
  /// Pack size as printed, e.g. "4/10 LB"
  packText          String?
  /// Quantity ordered, when the invoice prints it next to quantity shipped
  orderedQty        Decimal?         @db.Decimal(10, 2)

  @@index([invoiceId]) // perf
  @@index([supplierProductId])
}

// ---------------------------------------------------------------------------
// Reviews & targets
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  source     String   // GOOGLE | YELP | TRIPADVISOR | MANUAL
  externalId String?
  author     String?
  rating     Int
  text       String
  postedAt   DateTime
  themes     String[] @default([])
  sentiment  String?  // positive | mixed | negative
  replyDraft String?
  replied    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([source, externalId])
  @@index([postedAt])
}

/// Weekly targets; weekStart is a Monday.
model Budget {
  weekStart   DateTime @id @db.Date
  sales       Decimal? @db.Decimal(12, 2)
  foodCostPct Decimal? @db.Decimal(5, 4)
  laborPct    Decimal? @db.Decimal(5, 4)
}

// ---------------------------------------------------------------------------
// People: feedback and onboarding documents
// ---------------------------------------------------------------------------

enum FeedbackKind {
  PRAISE
  COACHING
  NOTE
}

/// A manager's note on an employee. Private to managers unless visibleToEmployee.
model EmployeeFeedback {
  id                String       @id @default(cuid())
  employeeId        String
  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  authorId          String?
  author            User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind              FeedbackKind @default(NOTE)
  body              String
  visibleToEmployee Boolean      @default(false)
  createdAt         DateTime     @default(now())

  @@index([employeeId, createdAt])
}

enum DocumentAudience {
  STAFF
  MANAGER
}

/// Handbook, tax forms, policies. Bytes live in Postgres (max 8 MB each).
model Document {
  id          String           @id @default(cuid())
  title       String
  kind        String           @default("POLICY") // HANDBOOK | POLICY | TAX_FORM | OTHER
  bytes       Bytes
  mime        String
  size        Int
  filename    String?
  /// Plain text used to answer policy questions (extracted on upload; editable).
  text        String?
  requiresAck Boolean          @default(false)
  audience    DocumentAudience @default(STAFF)
  uploadedBy  String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  acks        DocumentAck[]
  trainingSteps TrainingStep[]
}

model DocumentAck {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ackedAt    DateTime @default(now())

  @@unique([documentId, employeeId])
}

// ---------------------------------------------------------------------------
// People: training & certifications
// ---------------------------------------------------------------------------

/// A kind of certificate or required training (ATAP, ServSafe, harassment prevention…).
model CertType {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String?
  issuer            String?
  /// Months a certificate stays valid. Null = never expires.
  validityMonths    Int?
  /// Position ids whose holders must have it.
  appliesTo         String[] @default([])
  requiredForAll    Boolean  @default(false)
  /// Required for anyone marked as a minor (NY working papers).
  requiredForMinors Boolean  @default(false)
  /// Yearly training (e.g. NY sexual harassment prevention) rather than a card.
  isAnnualTraining  Boolean  @default(false)
  active            Boolean  @default(true)
  sort              Int      @default(0)
  createdAt         DateTime @default(now())
  certifications    Certification[]
}

/// One certificate a person holds. Renewals add a new row, so history is kept.
model Certification {
  id               String    @id @default(cuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  certTypeId       String
  certType         CertType  @relation(fields: [certTypeId], references: [id], onDelete: Cascade)
  number           String?
  issuedOn         DateTime  @db.Date
  /// From the type's validity unless expiryOverridden.
  expiresOn        DateTime? @db.Date
  expiryOverridden Boolean   @default(false)
  /// Photo or PDF of the card (max 8 MB).
  bytes            Bytes?
  mime             String?
  size             Int?
  filename         String?
  notes            String?
  uploadedBy       String?
  verifiedBy       String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([employeeId, certTypeId])
  @@index([expiresOn])
}

/// An onboarding / skills checklist ("New bartender").
model TrainingModule {
  id          String   @id @default(cuid())
  title       String
  description String?
  positionIds String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  steps       TrainingStep[]
  assignments TrainingAssignment[]
}

model TrainingStep {
  id          String         @id @default(cuid())
  moduleId    String
  module      TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  sort        Int            @default(0)
  title       String
  detail      String?
  documentId  String?
  document    Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  completions TrainingStepCompletion[]

  @@index([moduleId, sort])
}

model TrainingAssignment {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  moduleId    String
  module      TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignedAt  DateTime       @default(now())
  assignedBy  String?
  dueOn       DateTime?      @db.Date
  completedAt DateTime?
  signedOffBy String?
  signedOffAt DateTime?
  completions TrainingStepCompletion[]

  @@unique([employeeId, moduleId])
}

model TrainingStepCompletion {
  id           String             @id @default(cuid())
  assignmentId String
  assignment   TrainingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         TrainingStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  completedAt  DateTime           @default(now())
  completedBy  String?

  @@unique([assignmentId, stepId])
}

// ---------------------------------------------------------------------------
// Kegs: where every keg is, what's in it, and an append-only history.
// ---------------------------------------------------------------------------

enum KegStatus {
  EMPTY // clean and ready to fill
  FILLED // full, not in cold storage yet
  COLD // full, in the walk-in / keg cooler
  ON_TAP
  KICKED // ran out on a tap line
  OUT // out to an account
  CLEANING // back from an account or kicked, waiting to be cleaned
}

enum KegOwner {
  OURS
  DEPOSIT // someone else's keg we hold on deposit
  BORROWED
}

/// A beer that goes in kegs (house or guest). Matched to Square sales by item name.
model Beer {
  id           String   @id @default(cuid())
  name         String   @unique
  style        String?
  /// Board color (a preset key from src/domain/kegs.ts BEER_COLORS)
  color        String   @default("amber")
  house        Boolean  @default(true)
  /// The keg ingredient used for pour costing, e.g. "Subversive IPA (keg)"
  ingredientId String?
  /// The beer's PREP recipe (batch yield in bbl), so a keg's cost per pint comes from the batch cost
  recipeId     String?
  /// Square item names (the part before " · ") whose pours come out of this beer's kegs
  squareNames  String[] @default([])
  /// Alert when full kegs on hand drop below this many
  minFull      Int      @default(1)
  /// Retired when false ("Show retired" keeps its history). Standing: retired = !active; core = active && core; in rotation = active && !core
  active       Boolean  @default(true)
  /// A core beer: we never want to run out, so fill suggestions, run-out warnings and alerts apply to it
  core         Boolean  @default(false)
  notes        String?
  extra        Json?
  createdAt    DateTime @default(now())
  /// Tap list: alcohol by volume, %
  abv          Decimal? @db.Decimal(4, 1)
  ibu          Int?
  /// One or two lines for the board and the website
  description  String?
  /// "Gluten-reduced", "Gluten-free", "Contains lactose", "Vegan" (shown as a tag)
  diet         String?
  /// Board prices typed by hand ("16 oz $8, 10 oz $6"); blank = from Square / draft beer pours
  boardPours   String?
  /// Coming soon on the board: null = when a full keg is in cold storage, true = always, false = never
  comingSoon   Boolean?
  /// When a label image was uploaded (cache key for the image URL)
  labelAt      DateTime?
  label        BeerLabel?
  kegs         Keg[]
  fills        KegFill[]
  batches      KegBatch[]
  orderLines   KegOrderLine[]
  brewRecipes  BrewRecipe[]
  brewBatches  BrewBatch[]
}

/// A small label/logo image for a beer on the tap list (≤ 300 KB, resized in the browser).
model BeerLabel {
  beerId    String   @id
  beer      Beer     @relation(fields: [beerId], references: [id], onDelete: Cascade)
  mime      String
  bytes     Bytes
  updatedAt DateTime @updatedAt
}

model KegBatch {
  id         String    @id @default(cuid())
  code       String    @unique
  beerId     String?
  beer       Beer?     @relation(fields: [beerId], references: [id], onDelete: SetNull)
  brewedOn   DateTime? @db.Date
  packagedOn DateTime? @db.Date
  notes      String?
  extra      Json?
  fills      KegFill[]
  /// The brewery batch this keg batch was packaged from, when it was brewed in Ops.
  brewBatch  BrewBatch?
}

/// A named spot inside a storage area ("back left · stack 2"). Managers define them.
model KegSpot {
  id    String @id @default(cuid())
  area  String
  name  String
  sort  Int    @default(0)
  kegs  Keg[]

  @@unique([area, name])
}

/// Bars, restaurants, distributors or people kegs go out to.
model KegAccount {
  id        String   @id @default(cuid())
  name      String   @unique
  kind      String   @default("bar") // bar | restaurant | distributor | consumer | other
  contact   String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  extra     Json?
  createdAt DateTime @default(now())
  kegs      Keg[]
  events    KegEvent[]
  orders    KegOrder[]
}

model Keg {
  id         String     @id @default(cuid())
  /// Printed on the QR sticker, short and readable ("K7Q3M")
  code       String     @unique
  /// The code on a sticker from the previous keg app, so old stickers still scan
  legacyCode String?    @unique
  label      String?
  sizeId     String     @default("half")
  owner      KegOwner   @default(OURS)
  notes      String?
  active     Boolean    @default(true)
  status     KegStatus  @default(EMPTY)
  statusAt   DateTime   @default(now())
  beerId     String?
  beer       Beer?      @relation(fields: [beerId], references: [id], onDelete: SetNull)
  fillId     String?    @unique
  fill       KegFill?   @relation("CurrentFill", fields: [fillId], references: [id], onDelete: SetNull)
  area       String?
  spotId     String?
  spot       KegSpot?   @relation(fields: [spotId], references: [id], onDelete: SetNull)
  spotNote   String?
  tapLine    Int?
  accountId  String?
  account    KegAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Columns from an import we didn't map, kept as-is
  extra      Json?
  createdAt  DateTime   @default(now())
  fills      KegFill[]  @relation("KegFills")
  events     KegEvent[]
  orderKegs  KegOrderKeg[]

  @@index([status])
  @@index([beerId])
}

/// One fill of one keg: filled → tapped → kicked (or sent out).
model KegFill {
  id        String    @id @default(cuid())
  kegId     String
  keg       Keg       @relation("KegFills", fields: [kegId], references: [id], onDelete: Cascade)
  current   Keg?      @relation("CurrentFill")
  beerId    String?
  beer      Beer?     @relation(fields: [beerId], references: [id], onDelete: SetNull)
  batchId   String?
  batch     KegBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  batchCode String?
  filledOn  DateTime? @db.Date
  bestBy    DateTime? @db.Date
  tappedAt  DateTime?
  tapLine   Int?
  kickedAt  DateTime?
  /// Set on fills rebuilt from an imported history, so re-importing updates them
  importKey String?   @unique
  createdAt DateTime  @default(now())

  @@index([beerId, kickedAt])
}

/// Append-only history. Undo marks an event undone and restores `before`.
model KegEvent {
  id         String      @id @default(cuid())
  kegId      String
  keg        Keg         @relation(fields: [kegId], references: [id], onDelete: Cascade)
  at         DateTime    @default(now())
  userId     String?
  userName   String?
  action     String // CREATED FILLED STORED MOVED TAPPED KICKED OUT RETURNED CLEANED EMPTIED EDITED NOTE
  fromStatus KegStatus?
  toStatus   KegStatus?
  fromPlace  String?
  toPlace    String?
  beerId     String?
  fillId     String?
  tapLine    Int?
  accountId  String?
  account    KegAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  note       String?
  /// Keg fields before this event (for undo)
  before     Json?
  /// Events made by one tap (kick + replace) share a group
  groupId    String?
  undoneAt   DateTime?
  /// Phone-generated id, so a retried offline action is applied once
  clientId   String?     @unique
  /// Stable key for imported history rows, so re-importing never duplicates
  importKey  String?     @unique
  extra      Json?
  createdAt  DateTime    @default(now())

  @@index([kegId, at])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Keg orders: what a wholesale account asked for, filled by scanning kegs out.
// ---------------------------------------------------------------------------

enum KegOrderStatus {
  OPEN
  FULFILLED
  CANCELLED
}

/// A wholesale order: full kegs for one account, delivered or picked up.
model KegOrder {
  id              String         @id @default(cuid())
  /// A short order number people can say out loud ("order 42")
  number          Int            @unique @default(autoincrement())
  accountId       String
  account         KegAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transit         String         @default("DELIVERY") // DELIVERY | PICKUP
  dueOn           DateTime?      @db.Date
  status          KegOrderStatus @default(OPEN)
  createdAt       DateTime       @default(now())
  createdById     String?
  createdByName   String?
  fulfilledAt     DateTime?
  fulfilledByName String?
  cancelledAt     DateTime?
  cancelledByName String?
  lines           KegOrderLine[]
  kegs            KegOrderKeg[]
  notes           KegOrderNote[]

  @@index([status, dueOn])
  @@index([accountId])
}

/// One line of an order: this many kegs of one beer in one size.
model KegOrderLine {
  id        String        @id @default(cuid())
  orderId   String
  order     KegOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  beerId    String
  beer      Beer          @relation(fields: [beerId], references: [id], onDelete: Restrict)
  sizeId    String
  quantity  Int
  /// Kegs marked delivered without scanning (stickers that can't be read)
  unscanned Int           @default(0)
  sort      Int           @default(0)
  kegs      KegOrderKeg[]
}

/// A keg scanned out against an order line.
model KegOrderKeg {
  id       String       @id @default(cuid())
  orderId  String
  order    KegOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineId   String
  line     KegOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  kegId    String
  keg      Keg          @relation(fields: [kegId], references: [id], onDelete: Cascade)
  /// The KegEvent that sent it out (for undo)
  eventId  String?
  at       DateTime     @default(now())
  userName String?

  @@unique([orderId, kegId])
}

/// A note on an order. Anyone can add one; they are never edited.
model KegOrderNote {
  id       String   @id @default(cuid())
  orderId  String
  order    KegOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  at       DateTime @default(now())
  userId   String?
  userName String?
  text     String
}

/// End-of-shift handoff: what the next person (and tomorrow's morning brief) needs to know.
/// Anyone can write one; `date` is the business date of the shift it covers.
model ShiftNote {
  id            String    @id @default(cuid())
  date          DateTime  @db.Date
  /// "open" | "mid" | "close" — which shift this covers
  shift         String    @default("close")
  authorId      String?
  authorName    String
  /// Items that ran out (86'd)
  eightySixed   String[]  @default([])
  issues        String?
  comps         String?
  compsAmount   Decimal?  @db.Decimal(10, 2)
  /// Drawer note; over (+) / short (−) in dollars, if counted
  cash          String?
  cashOverShort Decimal?  @db.Decimal(10, 2)
  maintenance   String?
  notes         String?
  /// Quick chips picked ("Slammed", "Walk-in warm", "Short-staffed"…)
  tags          String[]  @default([])
  /// A manager ticked the follow-ups (issues / maintenance) as handled
  handledAt     DateTime?
  handledBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([date])
  @@index([createdAt])
}

// ---- Private events & parties (buyouts, rehearsal dinners, corporate) ----------------
// Additive. No foreign keys into existing models (owner, calendar Event and recipes are
// referenced by id) so the rest of the schema is untouched.

model PrivateEvent {
  id            String    @id @default(cuid())
  /// INQUIRY | QUOTED | DEPOSIT | CONFIRMED | DONE | LOST
  stage         String    @default("INQUIRY")
  clientName    String
  company       String?
  clientEmail   String?
  clientPhone   String?
  /// PARTY | BUYOUT | REHEARSAL | CORPORATE | WEDDING | FESTIVAL | OTHER
  type          String    @default("PARTY")
  date          DateTime? @db.Date
  startTime     String?
  endTime       String?
  space         String?
  headcount     Int       @default(0)
  /// User id (no relation, so User stays untouched)
  ownerId       String?
  notes         String?
  followUpOn    DateTime? @db.Date
  lostReason    String?
  /// Calendar Event this booking keeps up to date once confirmed
  calendarEventId String? @unique
  // Quote
  roomFee       Decimal   @default(0) @db.Decimal(10, 2)
  /// NONE | TICKETS | OPEN_TAB | MINIMUM
  barKind       String    @default("NONE")
  drinkTickets  Int       @default(0)
  ticketPrice   Decimal   @default(0) @db.Decimal(10, 2)
  barAmount     Decimal   @default(0) @db.Decimal(10, 2)
  serviceChargePct Decimal @default(0.2) @db.Decimal(5, 4)
  taxPct        Decimal   @default(0.08) @db.Decimal(5, 4)
  depositPct    Decimal   @default(0.25) @db.Decimal(5, 4)
  /// Fixed deposit; overrides the percent when set
  depositAmount Decimal?  @db.Decimal(10, 2)
  depositDueOn  DateTime? @db.Date
  balanceDueOn  DateTime? @db.Date
  quoteNote     String?
  quoteToken    String?   @unique
  quoteSentAt   DateTime?
  quoteViewedAt DateTime?
  acceptedAt    DateTime?
  acceptedName  String?
  /// Totals as the client accepted them (JSON snapshot)
  acceptedQuote Json?
  paymentLinkUrl    String?
  paymentLinkId     String?
  paymentLinkAmount Decimal? @db.Decimal(10, 2)
  remindedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lines         PrivateEventLine[]
  payments      PrivateEventPayment[]

  @@index([stage, date])
  @@index([date])
}

model PrivateEventLine {
  id             String       @id @default(cuid())
  privateEventId String
  privateEvent   PrivateEvent @relation(fields: [privateEventId], references: [id], onDelete: Cascade)
  /// ITEM (a menu recipe) | PACKAGE (per-person package) | CUSTOM
  kind           String       @default("ITEM")
  recipeId       String?
  packageId      String?
  label          String
  qty            Decimal      @default(1) @db.Decimal(10, 2)
  /// qty is per guest (× headcount) rather than a fixed count
  perPerson      Boolean      @default(false)
  unitPrice      Decimal      @default(0) @db.Decimal(10, 2)
  /// Cost per unit for CUSTOM lines (items and packages are costed live from recipes)
  unitCost       Decimal?     @db.Decimal(10, 4)
  sort           Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([privateEventId, sort])
}

model PrivateEventPayment {
  id             String       @id @default(cuid())
  privateEventId String
  privateEvent   PrivateEvent @relation(fields: [privateEventId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(10, 2)
  /// DEPOSIT | BALANCE | OTHER
  kind           String       @default("DEPOSIT")
  /// CARD | CASH | CHECK | SQUARE_LINK | OTHER
  method         String       @default("CARD")
  paidOn         DateTime     @db.Date
  note           String?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([privateEventId])
}

model PrivateEventPackage {
  id             String   @id @default(cuid())
  name           String
  description    String?
  pricePerPerson Decimal  @db.Decimal(10, 2)
  active         Boolean  @default(true)
  sort           Int      @default(0)
  createdAt      DateTime @default(now())
  items          PrivateEventPackageItem[]
}

model PrivateEventPackageItem {
  id        String              @id @default(cuid())
  packageId String
  package   PrivateEventPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  recipeId  String
  /// Portions per guest (0.5 = one for every two guests)
  perGuest  Decimal             @default(1) @db.Decimal(6, 2)
  sort      Int                 @default(0)

  @@index([packageId])
}

// ---------------------------------------------------------------------------
// Food safety: temperature logs, cooling logs, cleaning & opening/closing lists
// ---------------------------------------------------------------------------

// ---- Prep list (kitchen) ---------------------------------------------------------
// Keyed by PREP recipe id (no relation on Recipe, so the Recipe model stays untouched;
// rows for a deleted recipe are simply ignored).

/// Per prep recipe: on the list or not, par, shelf life, rounding, station and count unit.
model PrepSetting {
  recipeId      String   @id
  onList        Boolean  @default(true)
  /// Minimum to have on hand, in the recipe's base unit (ml, g or each).
  parBase       Decimal? @db.Decimal(14, 4)
  shelfLifeDays Int?
  /// "batch" (whole batches) | "half" (half batches) | "exact"
  rounding      String   @default("batch")
  station       String?
  /// What the kitchen counts and makes it in: a standard unit ("qt") or a container ("cambro").
  unitName      String?
  /// Base units in one `unitName` (only for containers; standard units convert themselves).
  unitBase      Decimal? @db.Decimal(14, 4)
  updatedAt     DateTime @updatedAt
}

/// What's on hand of a prep item, counted on the prep list.
model PrepCount {
  id        String   @id @default(cuid())
  recipeId  String
  qtyBase   Decimal  @db.Decimal(14, 4)
  countedAt DateTime @default(now())
  countedBy String?
  /// Made on the phone so a retried offline send is applied once.
  clientId  String?  @unique

  @@index([recipeId, countedAt])
}

/// A prep item made on a day (`day` = business date YYYY-MM-DD).
model PrepDone {
  id       String   @id @default(cuid())
  recipeId String
  day      String
  qtyBase  Decimal  @db.Decimal(14, 4)
  doneBy   String?
  doneById String?
  doneAt   DateTime @default(now())
  clientId String?  @unique

  @@unique([recipeId, day])
  @@index([day])
}

// ---- Card fees, comps & discounts from Square (P&L) -----------------------------------

/// Per business day: Square card processing fees (from payments and refunds) and the
/// comps & discounts total (from orders). A null column = that sync hasn't covered the day yet.
model SquareDayMoney {
  date              DateTime  @id @db.Date
  /// Fees on payments taken this day (positive = cost).
  cardFees          Decimal?  @db.Decimal(10, 2)
  /// Fees Square returned on refunds made this day (positive = money back).
  feesReturned      Decimal?  @db.Decimal(10, 2)
  feePayments       Int       @default(0)
  /// Completed non-cash payments with no fee reported yet.
  feePending        Int       @default(0)
  /// Total of the payments that carried a fee.
  feeVolume         Decimal?  @db.Decimal(12, 2)
  feesSyncedAt      DateTime?
  /// Comps & discounts in completed orders closed this day (every item, ignored ones included).
  discounts         Decimal?  @db.Decimal(10, 2)
  discountsSyncedAt DateTime?
}

/// One discount on one order line (negative for a return), as rung in Square.
model SquareDiscount {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  orderId      String
  name         String
  squareId     String   @default("")
  itemName     String
  /// Who took the payment for the order (Payment.team_member_id), "" when not known.
  teamMemberId String   @default("")
  amount       Decimal  @db.Decimal(10, 2)
  qty          Decimal  @db.Decimal(10, 3)
  /// The line ended at $0: given away whole.
  full         Boolean  @default(false)
  percentage   String?

  @@index([date])
  @@index([orderId])
}

// ---- Website: what guests see on the public site (feeds under /api/public) ------------
// Additive. Keyed by the id of the Ops row they describe (no relations), so Recipe, Event
// and Beer stay untouched; a row for something deleted is simply ignored.

/// Web fields for a menu recipe or add-on: whether and how it shows on the website menu.
model WebMenuItem {
  recipeId       String    @id
  onWebsite      Boolean   @default(false)
  /// Name on the website (blank = the recipe name)
  name           String?
  description    String?
  /// vegetarian | vegan | kid-friendly | dog-friendly
  tags           String[]  @default([])
  badge          String?
  /// Printed extras under the item, e.g. "Add bacon +3"
  modifiers      String?
  /// "food" or "drinks" (blank = guessed from the category)
  place          String?
  /// Section title on the website (blank = the recipe's category)
  section        String?
  sort           Int       @default(0)
  showPrice      Boolean   @default(true)
  availableFrom  DateTime? @db.Date
  availableUntil DateTime? @db.Date
  updatedAt      DateTime  @updatedAt
}

/// A menu section's website details (id is the section slug, e.g. "smash-burgers").
model WebMenuSection {
  id             String    @id
  title          String
  /// "food" or "drinks"
  place          String    @default("food")
  intro          String?
  note           String?
  modifiers      String?
  sort           Int       @default(0)
  availableFrom  DateTime? @db.Date
  availableUntil DateTime? @db.Date
  updatedAt      DateTime  @updatedAt
}

/// Web fields for a beer on the website's draft list (the rest comes from Beer and the tap list).
model WebBeer {
  beerId    String   @id
  onWebsite Boolean  @default(true)
  /// Light | Hoppy | Malty | Farmhouse | Sour (blank = guessed from the style)
  family    String?
  badge     String?
  hazy      Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Web fields for a calendar event.
model WebEvent {
  eventId              String   @id
  /// Stable URL slug, set once ("2026-11-21-knicks-vs-blazers")
  slug                 String   @unique
  hidden               Boolean  @default(false)
  /// Finer kind for the website (TRIVIA | MOVIE); blank = the event's kind
  webKind              String?
  /// null = the default for its kind (CLOSURE closed; HOLIDAY per the website setting)
  closed               Boolean?
  imageId              String?
  imageAlt             String?
  ticketUrl            String?
  rsvpUrl              String?
  priceLabel           String?
  featured             Boolean  @default(false)
  kitchenCloseOverride String?
  barCloseOverride     String?
  updatedAt            DateTime @updatedAt
}

/// An image uploaded for the website (resized in the browser, ≤ 1.5 MB).
model WebImage {
  id        String   @id @default(cuid())
  mime      String
  bytes     Bytes
  width     Int      @default(0)
  height    Int      @default(0)
  createdAt DateTime @default(now())
}

/// A private-event inquiry from the website form (it also creates a PrivateEvent INQUIRY).
model WebInquiry {
  id             String   @id @default(cuid())
  privateEventId String?
  name           String
  email          String?
  phone          String?
  date           DateTime? @db.Date
  guests         Int?
  type           String?
  message        String?
  /// Hash of the sender's IP (rate limiting; never the IP itself)
  ipHash         String
  seenAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

// ---- Website analytics (first-party, cookieless) + Google Search Console / Business Profile ----
// Additive only (migration 20261118100000_web_analytics). Raw hits are kept 400 days; pages read
// the daily rollups. No cookies, no raw IP: a visitor is a hash of IP + browser with a salt that
// changes every day, so nobody can be followed from one day to the next.

/// One page view or named event from the public website.
model WebHit {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  /// Business date (BUSINESS_TIMEZONE)
  day      DateTime @db.Date
  /// "pageview" or an event name (click_call, click_directions, menu_view, …)
  kind     String
  path     String
  /// sha256(daily salt + IP + user agent), shortened. The salt is replaced every day.
  visitor  String
  /// One visit: ends after 30 minutes without a hit, or when someone arrives from somewhere new
  session  String
  /// The visit's source (google, google-maps, instagram, direct…) and medium (organic, maps, social, referral, email, paid, direct)
  source   String
  medium   String
  campaign String?
  content  String?
  term     String?
  /// Referrer host only (never the full address)
  referrer String?
  /// mobile | tablet | desktop
  device   String
  country  String?
  region   String?
  city     String?
  props    Json?

  @@index([day])
  @@index([visitor, at])
  @@index([kind, day])
}

/// Daily rollup per dimension (total, page, source, medium, campaign, device, country, region,
/// city, referrer, event, eventSource, eventPage). Rebuilt from WebHit; pages read only these.
model WebDaily {
  day       DateTime @db.Date
  dim       String
  key       String
  views     Int      @default(0)
  visitors  Int      @default(0)
  sessions  Int      @default(0)
  entries   Int      @default(0)
  bounces   Int      @default(0)
  /// Visits that looked at the menu or an event
  engaged   Int      @default(0)
  /// Visits that took an action (call, directions, order, ticket, RSVP, inquiry)
  converted Int      @default(0)
  /// Event count (for event dimensions and actions on a page)
  count     Int      @default(0)

  @@id([day, dim, key])
  @@index([dim, day])
}

/// A conversion recorded by Ops itself (a private-event inquiry), with the visit's source.
model WebConversion {
  id             String   @id @default(cuid())
  at             DateTime @default(now())
  day            DateTime @db.Date
  kind           String
  source         String
  medium         String
  campaign       String?
  path           String?
  privateEventId String?
  props          Json?

  @@index([day])
  @@index([privateEventId])
}

/// Google Search Console, per day: total, and per query / page / device.
model GoogleSearchDaily {
  day         DateTime @db.Date
  /// total | query | page | device
  dim         String
  key         String
  clicks      Int
  impressions Int
  /// Average position (1 = top)
  position    Decimal  @db.Decimal(7, 2)

  @@id([day, dim, key])
  @@index([dim, day])
}

/// Google Business Profile Performance API daily metrics (BUSINESS_DIRECTION_REQUESTS, CALL_CLICKS…).
model GoogleProfileDaily {
  day    DateTime @db.Date
  metric String
  value  Int

  @@id([day, metric])
}

/// Google Business Profile search keywords, per month (unique users; Google hides small numbers).
model GoogleProfileKeyword {
  /// YYYY-MM
  month     String
  keyword   String
  value     Int?
  /// "Fewer than N" when Google only gives a threshold
  threshold Int?

  @@id([month, keyword])
}

/// Every change to how a Square item is linked (recipe, ignored, bought-in cost), so it can be undone.
model LinkChange {
  id         String    @id @default(cuid())
  at         DateTime  @default(now())
  /// Changes made together (a bulk accept) share a batch and undo together.
  batch      String
  userName   String?
  squareId   String
  squareName String
  /// { recipeId, recipeName, ignored, unitCost, costClass } before and after.
  before     Json
  after      Json
  undoneAt   DateTime?

  @@index([at])
  @@index([batch])
}

// ---- Shift checklists: opening, closing and mid-shift routines with sign-off ---------

/// A routine run every day (or on chosen weekdays): "Opening — bar", "Closing — kitchen".
model ChecklistTemplate {
  id          String          @id @default(cuid())
  name        String
  /// "open" | "mid" | "close" — when in the day it's done (closing lists done after midnight count for the day before)
  shift       String          @default("close")
  /// Positions it's for (empty = everyone)
  positionIds String[]        @default([])
  /// Weekdays it runs, 0 = Sunday (empty = every day)
  weekdays    Int[]           @default([])
  sort        Int             @default(0)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  items       ChecklistItem[]
  runs        ChecklistRun[]
}

model ChecklistItem {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sort       Int               @default(0)
  title      String
  detail     String?
  /// An app page that helps do it ("/kegs/scan", "/notes")
  href       String?
  /// Weekdays this item applies, 0 = Sunday (empty = whenever the list runs)
  weekdays   Int[]             @default([])
  active     Boolean           @default(true)
  ticks      ChecklistTick[]

  @@index([templateId, sort])
}

/// One day's run of a checklist. Created on the first tick.
model ChecklistRun {
  id            String            @id @default(cuid())
  templateId    String
  template      ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Business date the run covers
  date          DateTime          @db.Date
  signedOffAt   DateTime?
  signedOffBy   String?
  signedOffName String?
  note          String?
  createdAt     DateTime          @default(now())
  ticks         ChecklistTick[]

  @@unique([templateId, date])
  @@index([date])
}

model ChecklistTick {
  id       String        @id @default(cuid())
  runId    String
  run      ChecklistRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId   String
  item     ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  doneAt   DateTime      @default(now())
  userId   String?
  userName String

  @@unique([runId, itemId])
}

// ---- Upkeep: equipment, recurring maintenance and the repair log ---------------------

model Equipment {
  id            String       @id @default(cuid())
  name          String
  /// "Bar" | "Kitchen" | "Cellar" | "Brewhouse" | "Building" | anything typed
  area          String       @default("Bar")
  make          String?
  model         String?
  serial        String?
  /// Who services or repairs it
  vendor        String?
  vendorPhone   String?
  installedOn   DateTime?    @db.Date
  warrantyUntil DateTime?    @db.Date
  notes         String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  tasks         UpkeepTask[]
  logs          UpkeepLog[]
}

/// A job that comes round every N days ("Clean draft lines", every 14).
model UpkeepTask {
  id          String      @id @default(cuid())
  equipmentId String?
  equipment   Equipment?  @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  title       String
  everyDays   Int
  /// Last time it was done (kept in step with the log)
  lastDoneOn  DateTime?   @db.Date
  /// Staff can tick it off from their checklists; off = a manager or outside vendor job
  staffCanDo  Boolean     @default(false)
  vendor      String?
  howTo       String?
  active      Boolean     @default(true)
  sort        Int         @default(0)
  createdAt   DateTime    @default(now())
  logs        UpkeepLog[]
}

/// Append-only: a job done, a repair, a service visit, a note.
model UpkeepLog {
  id          String      @id @default(cuid())
  date        DateTime    @db.Date
  /// "done" (a recurring job) | "repair" | "service" | "note"
  kind        String      @default("done")
  taskId      String?
  task        UpkeepTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  equipmentId String?
  equipment   Equipment?  @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  title       String
  cost        Decimal?    @db.Decimal(10, 2)
  vendor      String?
  /// Out of service until fixed (repairs)
  down        Boolean     @default(false)
  fixedOn     DateTime?   @db.Date
  note        String?
  userId      String?
  userName    String?
  createdAt   DateTime    @default(now())

  @@index([date])
  @@index([equipmentId, date])
}

// ---- Beer tax: removals worksheet for federal excise, the brewer's report and NY ------

/// Gallons the keg history can't see: cans/crowlers/growlers out the door, beer returned, losses.
model BeerTaxAdjustment {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  /// "packaged" (packaged outside kegs) | "removed" (taxable removal outside kegs) | "returned" (back to the brewery) | "loss" (dumped/destroyed)
  kind      String
  gallons   Decimal  @db.Decimal(10, 2)
  beerId    String?
  note      String?
  userName  String?
  createdAt DateTime @default(now())

  @@index([date])
}

/// A return marked as filed for one period.
model BeerTaxFiling {
  id          String   @id @default(cuid())
  /// "federal" (TTB excise return) | "brop" (TTB brewer's report) | "ny" (NY beer tax return)
  form        String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  filedOn     DateTime @db.Date
  amount      Decimal? @db.Decimal(10, 2)
  note        String?
  userName    String?
  createdAt   DateTime @default(now())

  @@unique([form, periodStart])
}

// ---- Workforce: new-hire onboarding, recognition, payroll hand-off, staff messages --------

/// A reusable new-hire checklist ("Bartender", "Kitchen").
model OnboardingTemplate {
  id          String                   @id @default(cuid())
  name        String
  /// Positions it's suggested for (empty = anyone).
  positionIds String[]                 @default([])
  active      Boolean                  @default(true)
  sort        Int                      @default(0)
  createdAt   DateTime                 @default(now())
  items       OnboardingTemplateItem[]
  onboardings Onboarding[]
}

/// kind: DOCUMENT (sign a document; refId = document id, null = every document that needs signing)
/// TRAINING (refId = module id, null = their assigned training) | CERT (refId = cert type id, null = every certificate their position needs)
/// PAYROLL (W-4 / I-9 / direct deposit done in the payroll provider — a checkbox only) | AVAILABILITY | EMERGENCY | TASK (uniform, keys…)
model OnboardingTemplateItem {
  id           String             @id @default(cuid())
  templateId   String
  template     OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sort         Int                @default(0)
  kind         String
  title        String
  detail       String?
  refId        String?
  required     Boolean            @default(true)
  /// TASK: the new hire can tick it themselves (otherwise a manager does).
  staffCanTick Boolean            @default(false)

  @@index([templateId, sort])
}

/// One new hire's checklist. Items are copied from the template so later template edits don't change it.
model Onboarding {
  id          String              @id @default(cuid())
  employeeId  String
  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId  String?
  template    OnboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  startDate   DateTime            @db.Date
  dueOn       DateTime?           @db.Date
  /// ACTIVE | DONE | CANCELLED
  status      String              @default("ACTIVE")
  /// MANUAL | SQUARE (started from a person the Square team sync brought in)
  source      String              @default("MANUAL")
  createdBy   String?
  createdAt   DateTime            @default(now())
  completedAt DateTime?
  /// The new hire opened their checklist (first login).
  seenAt      DateTime?
  items       OnboardingItem[]

  @@index([employeeId])
  @@index([status])
}

model OnboardingItem {
  id           String     @id @default(cuid())
  onboardingId String
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  sort         Int        @default(0)
  kind         String
  title        String
  detail       String?
  refId        String?
  required     Boolean    @default(true)
  staffCanTick Boolean    @default(false)
  doneAt       DateTime?
  doneBy       String?

  @@index([onboardingId, sort])
}

/// A shout-out: thanks tied to one of the house values. Managers give them; peers too when switched on.
model Shoutout {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromUserId String?
  fromName   String
  /// One of the values in Setting recognition.config (free text kept as given).
  value      String?
  body       String
  /// Points added to the person's balance (0 when points are off).
  points     Int      @default(0)
  /// Peer shout-outs can be hidden by a manager.
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([employeeId, createdAt])
}

/// Something points can be swapped for (a growler fill, a shift meal, a day picking the playlist).
model Reward {
  id          String             @id @default(cuid())
  name        String
  description String?
  cost        Int
  active      Boolean            @default(true)
  sort        Int                @default(0)
  createdAt   DateTime           @default(now())
  redemptions RewardRedemption[]
}

model RewardRedemption {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  rewardId   String
  reward     Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  points     Int
  /// PENDING | APPROVED | DENIED
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
  decidedBy  String?

  @@index([employeeId])
  @@index([status])
}

/// Every payroll file downloaded for a pay period (format, who, totals), so the hand-off has a history.
model PayrollExport {
  id          String   @id @default(cuid())
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  /// SQUARE_PAYROLL | GUSTO | GENERIC | ACCOUNTANT
  format      String
  /// Exported from the approved snapshot (true) or a live draft (false).
  approved    Boolean  @default(false)
  people      Int      @default(0)
  hours       Decimal  @default(0) @db.Decimal(10, 2)
  gross       Decimal  @default(0) @db.Decimal(12, 2)
  tips        Decimal  @default(0) @db.Decimal(12, 2)
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([periodStart, periodEnd])
}

/// A note from a staff member to the managers: a question, an idea, a heads-up. Managers can reply.
model StaffMessage {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// QUESTION | IDEA | CONCERN | OTHER
  kind       String    @default("QUESTION")
  body       String
  /// The sender's name is hidden from managers (only for IDEA / CONCERN).
  anonymous  Boolean   @default(false)
  readAt     DateTime?
  readBy     String?
  reply      String?
  repliedAt  DateTime?
  repliedBy  String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([employeeId, createdAt])
}

/// One number a day from any place the business is present online (Instagram, the Facebook Page,
/// later a review site): `channel` is "instagram" | "facebook" | …, `metric` a short stable name
/// (views, reach, followers, profile_taps…). Aggregates only; nothing about any one person.
model OnlineChannelDaily {
  channel String
  day     DateTime @db.Date
  metric  String
  value   Decimal  @db.Decimal(14, 2)

  @@id([channel, day, metric])
  @@index([channel, metric, day])
}

/// The business's own posts on a channel, with their latest numbers (refreshed by the nightly sync).
model OnlinePost {
  id            String    @id @default(cuid())
  channel       String
  /// The post's id on the channel.
  externalId    String
  postedAt      DateTime
  /// post | reel | video | carousel | link | text
  kind          String
  /// The first couple of hundred characters of the caption.
  caption       String?
  permalink     String?
  /// The channel's own image address. It can stop working after a while, so pages must cope without it.
  thumbnailUrl  String?
  views         Int?
  reach         Int?
  likes         Int?
  comments      Int?
  saves         Int?
  shares        Int?
  interactions  Int?
  profileVisits Int?
  follows       Int?
  /// Numbers only one channel has (e.g. { clicks, avgWatchSeconds }).
  extra         Json?
  /// When the numbers above were last read; null while the channel has none for this post yet.
  metricsAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([channel, externalId])
  @@index([channel, postedAt])
}

// ---- Brewery: tanks, brewing recipes, batches and the tank schedule ----------------

enum TankKind {
  FERMENTER
  BRITE
  OTHER
}

enum BrewStatus {
  PLANNED // on the schedule, not brewed yet
  FERMENTING // brewed, in a fermenter
  CONDITIONING // in a brite tank
  PACKAGED // in kegs (or cans); done
  DUMPED // lost or poured out
}

/// A tank in the brewery: fermenters and brite tanks, with their size in barrels.
model Tank {
  id          String     @id @default(cuid())
  name        String     @unique
  kind        TankKind   @default(FERMENTER)
  capacityBbl Decimal    @db.Decimal(6, 2)
  sort        Int        @default(0)
  active      Boolean    @default(true)
  notes       String?
  /// Floor plan: the room or wall it stands in ("Back wall", "Front", "Separate room"), and its row and column there
  zone        String?
  layoutRow   Int?
  layoutCol   Int?
  stays       TankStay[]
}

/// A brewing recipe (grain bill, hops, yeast, process) for one beer. Costed live from ingredient prices.
model BrewRecipe {
  id            String           @id @default(cuid())
  name          String           @unique
  beerId        String?
  beer          Beer?            @relation(fields: [beerId], references: [id], onDelete: SetNull)
  style         String?
  /// "live" (brewed), "dev" (in development) or "archived"
  status        String           @default("live")
  /// Finished batch size in US beer barrels (31 gal)
  batchBbl      Decimal          @default(7) @db.Decimal(6, 2)
  /// Brewhouse efficiency, percent (e.g. 72)
  efficiencyPct Decimal          @default(72) @db.Decimal(5, 2)
  boilMinutes   Int              @default(60)
  targetOg      Decimal?         @db.Decimal(6, 4)
  targetFg      Decimal?         @db.Decimal(6, 4)
  /// Brew-day gravity targets (stored as specific gravity; shown in °Plato or SG): mash tun, boil kettle, knock-out
  targetMt      Decimal?         @db.Decimal(6, 4)
  targetBk      Decimal?         @db.Decimal(6, 4)
  targetKo      Decimal?         @db.Decimal(6, 4)
  /// Strike water and mash temperatures, °F, and mash rest in minutes
  strikeF       Decimal?         @db.Decimal(5, 1)
  mashF         Decimal?         @db.Decimal(5, 1)
  mashMinutes   Int?
  /// Timing profile ("hazy" | "sour" | "lager" | "pale" or custom): drives dry-hop, transfer, packaging and release dates
  profile       String?
  /// Days from brew day to the dry hop, and to tap/release
  dryHopDay     Int?
  tapDay        Int?
  /// Development beers: label artwork finished
  artworkDone   Boolean          @default(false)
  /// Usual days in a fermenter, then in a brite tank (drives the tank schedule)
  fermentDays   Int              @default(14)
  conditionDays Int              @default(7)
  notes         String?
  extra         Json?
  /// Where it was imported from, e.g. "brewmanager:<id>" (re-imports update instead of duplicating)
  sourceKey     String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lines         BrewRecipeLine[]
  batches       BrewBatch[]

  @@index([beerId])
}

/// One ingredient in a brewing recipe. Matched to an Ingredient for its price when possible.
model BrewRecipeLine {
  id             String      @id @default(cuid())
  recipeId       String
  recipe         BrewRecipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  /// "grain" | "hop" | "yeast" | "adjunct" | "water" | "other"
  kind           String
  /// As written in the recipe (kept even when matched to an ingredient)
  name           String
  ingredientId   String?
  ingredient     Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  qty            Decimal     @db.Decimal(14, 4)
  /// lb, oz, kg, g, gal, l, ml, pkg, each
  unit           String
  /// Grain: extract potential as specific gravity points per pound per gallon (e.g. 37)
  potentialPpg   Decimal?    @db.Decimal(5, 2)
  /// Grain: colour in degrees Lovibond
  colorL         Decimal?    @db.Decimal(6, 1)
  /// Hop: alpha acid percent
  alphaPct       Decimal?    @db.Decimal(4, 1)
  /// Hop: "boil" | "whirlpool" | "dryhop" | "firstwort" | "mash"
  use            String?
  /// Hop: minutes in the boil or whirlpool; dry hop: days
  minutes        Int?
  /// Yeast: apparent attenuation percent
  attenuationPct Decimal?    @db.Decimal(4, 1)
  sort           Int         @default(0)

  @@index([recipeId])
  @@index([ingredientId])
}

/// One brew: planned or done, with where it sat and when it was packaged.
model BrewBatch {
  id         String      @id @default(cuid())
  /// Batch code, e.g. "26-031"
  code       String      @unique
  recipeId   String?
  recipe     BrewRecipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  beerId     String?
  beer       Beer?       @relation(fields: [beerId], references: [id], onDelete: SetNull)
  status     BrewStatus  @default(PLANNED)
  plannedOn  DateTime?   @db.Date
  brewedOn   DateTime?   @db.Date
  packagedOn DateTime?   @db.Date
  /// Volume in barrels (planned, then actual)
  bbl        Decimal?    @db.Decimal(6, 2)
  og         Decimal?    @db.Decimal(6, 4)
  fg         Decimal?    @db.Decimal(6, 4)
  /// Brew-day log by stage (mash, lauter, boil, fermentation, packaging): readings, times, hop additions ticked off
  brewLog    Json?
  /// What packaging produced
  halfKegs   Int?
  sixthKegs  Int?
  cases      Int?
  co2Vols    Decimal?    @db.Decimal(3, 2)
  /// Planned dry-hop and tap/release days; a locked release date can't move when the schedule shifts
  dryHopOn   DateTime?   @db.Date
  tapOn      DateTime?   @db.Date
  tapLocked  Boolean     @default(false)
  lockedReason String?
  /// Supplier orders placed for this brew: { "<supplier name>": "YYYY-MM-DD" }
  ordered    Json?
  /// A split batch: brewed together, split into separate fermenters (e.g. two lagers from one base)
  splitFromId String?
  splitFrom  BrewBatch?  @relation("BrewSplit", fields: [splitFromId], references: [id], onDelete: SetNull)
  splits     BrewBatch[] @relation("BrewSplit")
  stockMoves BrewStockMove[]
  /// Ingredient cost of the brew, worked out when it was brewed (prices change later)
  cost       Decimal?    @db.Decimal(10, 2)
  /// The keg batch its kegs were filled from
  kegBatchId String?     @unique
  kegBatch   KegBatch?   @relation(fields: [kegBatchId], references: [id], onDelete: SetNull)
  notes      String?
  extra      Json?
  sourceKey  String?     @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  stays      TankStay[]

  @@index([status])
  @@index([beerId])
}

/// A batch's time in one tank (planned or actual). A batch usually has a fermenter stay, then a brite stay.
model TankStay {
  id      String    @id @default(cuid())
  tankId  String
  tank    Tank      @relation(fields: [tankId], references: [id], onDelete: Cascade)
  batchId String
  batch   BrewBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  start   DateTime  @db.Date
  /// Planned or actual last day in the tank; null = still in it with no end planned
  end     DateTime? @db.Date
  /// false once the batch actually went in
  planned Boolean   @default(true)

  @@index([tankId, start])
  @@index([batchId])
}

/// Brewing ingredient stock, kept apart from kitchen counts: counts, deliveries, what each brew used, and fixes.
/// On hand = the latest count plus everything received, less everything used, since that count.
model BrewStockMove {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  at           DateTime   @default(now())
  /// "count" (what's on the shelf now) | "received" | "used" (by a brew) | "adjust"
  kind         String
  /// In the ingredient's base unit (g, ml or each); "used" is positive and subtracted
  qtyBase      Decimal    @db.Decimal(14, 4)
  batchId      String?
  batch        BrewBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  note         String?
  userName     String?

  @@index([ingredientId, at])
  @@index([batchId])
}

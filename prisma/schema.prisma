// Subversive Ops — internal kitchen ops (costing, ordering, counts).
//
// Design rules that keep costs "live" while preserving history:
//   * Prices are NEVER overwritten. Each change is a new PriceRecord with an
//     effectiveDate. "Current cost" = latest record; "cost on date X" = latest
//     record on or before X. This replaces the old "add another tab" approach.
//   * Every quantity is stored in the ingredient's base unit (g, ml or each).
//     Recipes can use any unit; it's converted at calculation time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // pooled, for the app
  directUrl = env("DATABASE_URL_UNPOOLED") // direct, for migrations
}

enum Role {
  MANAGER
  STAFF
}

enum BaseUnit {
  g
  ml
  each
}

enum SupplierKind {
  DISTRIBUTOR // sends a downloadable price sheet
  LOCAL // bakery, butcher, etc. — prices entered by hand
}

enum PriceSource {
  IMPORT
  MANUAL
  SCRAPE
}

enum RecipeKind {
  MENU // sold item (maps to a Square item variation)
  PREP // sauce, dough, batch — used inside other recipes
  MODIFIER // add-on like "add bacon" (maps to a Square modifier)
}

enum OrderStatus {
  DRAFT
  SENT
  RECEIVED
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  pinHash   String
  role      Role     @default(STAFF)
  active    Boolean  @default(true)
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?
  createdAt DateTime @default(now())
  counts    StockCount[]
}

model Setting {
  key   String @id
  value String
}

model Supplier {
  id            String         @id @default(cuid())
  name          String         @unique
  kind          SupplierKind   @default(DISTRIBUTOR)
  email         String?
  // Days of week the supplier delivers, 0=Sun..6=Sat
  deliveryDays  Int[]          @default([])
  leadTimeDays  Int            @default(1)
  minOrder      Decimal?       @db.Decimal(10, 2)
  // Remembered column mapping for this supplier's price sheet
  importMapping Json?
  notes         String?
  active        Boolean        @default(true)
  products      SupplierProduct[]
  imports       PriceImport[]
  orders        PurchaseOrder[]
  invoices      Invoice[]
}

model Ingredient {
  id          String       @id @default(cuid())
  name        String       @unique
  category    String       @default("Other")
  storageArea String       @default("Dry storage")
  baseUnit    BaseUnit
  // Usable fraction after trim/cook loss (e.g. 0.85). Cost is divided by this.
  yieldPct    Decimal      @default(1) @db.Decimal(5, 4)
  // Extra buffer when ordering, as a fraction of forecast usage
  safetyPct   Decimal      @default(0.15) @db.Decimal(5, 4)
  // Unit staff count in (e.g. "case", "lb", "each"); defaults to base unit
  countUnit   String?
  // Which product we normally buy this ingredient as
  preferredProductId String? @unique
  preferredProduct   SupplierProduct? @relation("Preferred", fields: [preferredProductId], references: [id], onDelete: SetNull)
  active      Boolean      @default(true)
  notes       String?
  products    SupplierProduct[]
  conversions UnitConversion[]
  recipeLines RecipeLine[]
  countLines  StockCountLine[]
  wasteLogs   WasteLog[]
}

// Ingredient-specific units: "1 slice = 21 g", "1 cup = 120 g" (flour), "1 bun = 1 each"
model UnitConversion {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unit         String
  baseQty      Decimal    @db.Decimal(14, 4)

  @@unique([ingredientId, unit])
}

// A specific thing a supplier sells, e.g. "Heinz Ketchup 6/#10 can, SKU 123".
model SupplierProduct {
  id           String      @id @default(cuid())
  supplierId   String
  supplier     Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  preferredFor Ingredient? @relation("Preferred")
  sku          String
  description  String
  packText     String?     // as printed on the sheet, e.g. "6/#10"
  purchaseUnit String      @default("case")
  // How much of the ingredient's base unit one purchase unit contains
  packQtyBase  Decimal?    @db.Decimal(14, 4)
  url          String?     // supplier web page, for future price checks
  active       Boolean     @default(true)
  prices       PriceRecord[]
  orderLines   PurchaseOrderLine[]
  invoiceLines InvoiceLine[]

  @@unique([supplierId, sku])
}

model PriceRecord {
  id                String          @id @default(cuid())
  supplierProductId String
  product           SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  price             Decimal         @db.Decimal(10, 2) // per purchase unit
  effectiveDate     DateTime        @db.Date
  source            PriceSource
  importId          String?
  import            PriceImport?    @relation(fields: [importId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())

  @@index([supplierProductId, effectiveDate])
}

model PriceImport {
  id            String        @id @default(cuid())
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  filename      String
  effectiveDate DateTime      @db.Date
  rowCount      Int
  newProducts   Int
  priceChanges  Int
  createdAt     DateTime      @default(now())
  prices        PriceRecord[]
}

model Recipe {
  id         String      @id @default(cuid())
  name       String      @unique
  kind       RecipeKind  @default(MENU)
  category   String      @default("Food")
  menuPrice  Decimal?    @db.Decimal(10, 2)
  // For PREP recipes: what one batch yields, e.g. 2000 ml of aioli
  yieldQty   Decimal     @default(1) @db.Decimal(14, 4)
  yieldUnit  String      @default("each")
  // Base unit the yield converts to (prep recipes act like an ingredient)
  yieldBase  BaseUnit    @default(each)
  targetFoodCostPct Decimal? @db.Decimal(5, 4)
  active     Boolean     @default(true)
  notes      String?
  lines      RecipeLine[] @relation("RecipeLines")
  usedIn     RecipeLine[] @relation("SubRecipe")
  squareMaps SquareMapping[]
}

model RecipeLine {
  id           String      @id @default(cuid())
  recipeId     String
  recipe       Recipe      @relation("RecipeLines", fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  subRecipeId  String?
  subRecipe    Recipe?     @relation("SubRecipe", fields: [subRecipeId], references: [id], onDelete: Restrict)
  qty          Decimal     @db.Decimal(14, 4)
  unit         String
  sort         Int         @default(0)
}

// Links a Square catalog object (item variation or modifier) to a recipe.
model SquareMapping {
  squareId   String  @id
  squareName String
  squareType String  // ITEM_VARIATION | MODIFIER
  recipeId   String?
  recipe     Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  ignored    Boolean @default(false) // e.g. gift cards, merch
}

// Daily sales per Square object (variation or modifier) — aggregated from orders.
model DailySale {
  date      DateTime @db.Date
  squareId  String
  name      String
  qty       Decimal  @db.Decimal(12, 3)
  netSales  Decimal  @db.Decimal(12, 2)

  @@id([date, squareId])
  @@index([squareId])
}

model StockCount {
  id        String   @id @default(cuid())
  takenAt   DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  area      String?
  completed Boolean  @default(false)
  lines     StockCountLine[]
}

model StockCountLine {
  id           String     @id @default(cuid())
  countId      String
  count        StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qtyBase      Decimal    @db.Decimal(14, 4)

  @@unique([countId, ingredientId])
}

model WasteLog {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qtyBase      Decimal    @db.Decimal(14, 4)
  reason       String
  loggedBy     String?
  loggedAt     DateTime   @default(now())
}

model PurchaseOrder {
  id           String      @id @default(cuid())
  supplierId   String
  supplier     Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status       OrderStatus @default(DRAFT)
  deliveryDate DateTime    @db.Date
  coverUntil   DateTime    @db.Date
  createdAt    DateTime    @default(now())
  sentAt       DateTime?
  receivedAt   DateTime?
  notes        String?
  lines        PurchaseOrderLine[]
  invoices     Invoice[]
}

model PurchaseOrderLine {
  id                String          @id @default(cuid())
  orderId           String
  order             PurchaseOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierProductId String
  product           SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  suggestedQty      Decimal         @db.Decimal(10, 2)
  qty               Decimal         @db.Decimal(10, 2)
  unitPrice         Decimal?        @db.Decimal(10, 2)
  receivedQty       Decimal?        @db.Decimal(10, 2)
}

// ---------------------------------------------------------------------------
// Labor & scheduling
// ---------------------------------------------------------------------------

model Position {
  id         String   @id @default(cuid())
  name       String   @unique
  color      String   @default("#64748b")
  area       String   @default("FOH") // FOH | BOH | BAR
  defaultRate Decimal? @db.Decimal(8, 2)
  tipPoints  Decimal  @default(1) @db.Decimal(5, 2)
  tipEligible Boolean @default(true)
  sort       Int      @default(0)
  // Staffing: one person per $salesPerHour of forecast sales, within min/max.
  salesPerHour Decimal? @db.Decimal(8, 2)
  minStaff   Int      @default(0)
  maxStaff   Int      @default(3)
  employees  EmployeePosition[]
  shifts     Shift[]
  timecards  Timecard[]
}

model Employee {
  id                 String   @id @default(cuid())
  name               String
  email              String?
  phone              String?
  userId             String?  @unique
  squareTeamMemberId String?  @unique
  hourlyRate         Decimal? @db.Decimal(8, 2)
  isMinor            Boolean  @default(false)
  maxHoursWeek       Int?
  /// { "0": [["16:00","22:00"]], ... } weekday → available windows; missing day = unavailable
  availability       Json?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  positions          EmployeePosition[]
  shifts             Shift[]
  timecards          Timecard[]
  timeOff            TimeOffRequest[]
  swapsRequested     ShiftSwap[] @relation("SwapRequester")
  swapsTaken         ShiftSwap[] @relation("SwapTaker")
  tips               TipAllocation[]
  payAdjustments     PayAdjustment[]
}

model EmployeePosition {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  rate       Decimal? @db.Decimal(8, 2)

  @@id([employeeId, positionId])
}

model Shift {
  id           String    @id @default(cuid())
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  positionId   String
  position     Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  start        DateTime
  end          DateTime
  breakMinutes Int       @default(0)
  published    Boolean   @default(false)
  notes        String?
  createdAt    DateTime  @default(now())
  swaps        ShiftSwap[]

  @@index([start])
}

enum TimecardSource {
  SQUARE
  MANUAL
}

model Timecard {
  id           String         @id @default(cuid())
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  positionId   String?
  position     Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  clockIn      DateTime
  clockOut     DateTime?
  breakMinutes Int            @default(0)
  hourlyRate   Decimal?       @db.Decimal(8, 2)
  source       TimecardSource @default(MANUAL)
  squareId     String?        @unique
  /// Set when a manager changes the card in Ops; the Square sync must not overwrite it.
  manuallyEdited Boolean      @default(false)
  /// Set when the pay period/week is approved; approved cards are read-only until unlocked.
  approvedAt   DateTime?
  approvedBy   String?

  @@index([clockIn])
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum TimeOffType {
  PTO
  SICK
  UNPAID
}

model TimeOffRequest {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  DateTime      @db.Date
  endDate    DateTime      @db.Date
  type       TimeOffType   @default(UNPAID)
  /// Paid hours to draw from a balance (SICK/PTO). Null = work it out from scheduled shifts.
  hours      Decimal?      @db.Decimal(6, 2)
  note       String?
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
}

model ShiftSwap {
  id          String        @id @default(cuid())
  shiftId     String
  shift       Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  requesterId String
  requester   Employee      @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  takerId     String?
  taker       Employee?     @relation("SwapTaker", fields: [takerId], references: [id], onDelete: SetNull)
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
}

model TipPeriod {
  id          String   @id @default(cuid())
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  totalTips   Decimal  @db.Decimal(10, 2)
  method      String   // HOURS | POINTS
  createdAt   DateTime @default(now())
  finalized   Boolean  @default(false)
  allocations TipAllocation[]
}

model TipAllocation {
  id         String    @id @default(cuid())
  periodId   String
  period     TipPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hours      Decimal   @db.Decimal(8, 2)
  points     Decimal   @db.Decimal(10, 2)
  amount     Decimal   @db.Decimal(10, 2)
}

/// One-off pay lines (bonus, correction, deduction, reimbursement) on a business date.
model PayAdjustment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  kind       String   @default("BONUS") // BONUS | CORRECTION | DEDUCTION | REIMBURSEMENT
  /// Signed dollars; deductions are stored negative.
  amount     Decimal  @db.Decimal(10, 2)
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([date])
}

enum PayPeriodStatus {
  OPEN
  APPROVED
}

/// A pay period. Approving it locks its timecards and stores the payroll rows as they were.
model PayPeriod {
  id         String          @id @default(cuid())
  startDate  DateTime        @db.Date
  endDate    DateTime        @db.Date
  status     PayPeriodStatus @default(OPEN)
  approvedBy String?
  approvedAt DateTime?
  /// Payroll rows + totals at approval time (see domain/payroll.ts PayrollSnapshot).
  snapshot   Json?
  createdAt  DateTime        @default(now())

  @@unique([startDate, endDate])
}

/// Manager → team notes shown on My shifts.
model Announcement {
  id        String    @id @default(cuid())
  body      String
  author    String?
  pinned    Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Demand signals
// ---------------------------------------------------------------------------

/// Whole-store sales by hour (business-local hour 0–23), for hourly forecasts and labor.
model HourlySale {
  date     DateTime @db.Date
  hour     Int
  netSales Decimal  @db.Decimal(12, 2)
  orders   Int

  @@id([date, hour])
}

model Event {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  title     String
  kind      String   @default("OTHER") // GAME | FESTIVAL | MUSIC | PRIVATE | CLOSURE | HOLIDAY | OTHER
  startTime String?  // "19:30"
  endTime   String?
  /// Expected demand multiplier for the day (1.3 = +30%). Learned values can overwrite it.
  impact    Decimal  @default(1) @db.Decimal(5, 3)
  notes     String?
  createdAt DateTime @default(now())

  @@index([date])
}

model WeatherDay {
  date      DateTime @id @db.Date
  tempMaxC  Decimal  @db.Decimal(5, 1)
  tempMinC  Decimal  @db.Decimal(5, 1)
  precipMm  Decimal  @db.Decimal(6, 1)
  code      Int
  forecast  Boolean  @default(true)
  fetchedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Invoices
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  NEEDS_REVIEW
  MATCHED
  PRICE_ISSUE
  QTY_ISSUE
  PRICE_AND_QTY
  APPROVED
}

model Invoice {
  id            String        @id @default(cuid())
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  orderId       String?
  order         PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoiceNumber String?
  invoiceDate   DateTime      @db.Date
  total         Decimal?      @db.Decimal(10, 2)
  status        InvoiceStatus @default(NEEDS_REVIEW)
  image         Bytes?
  imageType     String?
  extractedBy   String?       // "claude" | "manual"
  approvedBy    String?
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  lines         InvoiceLine[]

  @@unique([supplierId, invoiceNumber])
}

model InvoiceLine {
  id                String           @id @default(cuid())
  invoiceId         String
  invoice           Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  supplierProductId String?
  product           SupplierProduct? @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  sku               String?
  description       String
  qty               Decimal          @db.Decimal(10, 2)
  unitPrice         Decimal          @db.Decimal(10, 2)
  expectedQty       Decimal?         @db.Decimal(10, 2)
  expectedPrice     Decimal?         @db.Decimal(10, 2)
  status            String           @default("OK") // OK | PRICE | QTY | PRICE_QTY | UNMATCHED
}

// ---------------------------------------------------------------------------
// Reviews & targets
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  source     String   // GOOGLE | YELP | TRIPADVISOR | MANUAL
  externalId String?
  author     String?
  rating     Int
  text       String
  postedAt   DateTime
  themes     String[] @default([])
  sentiment  String?  // positive | mixed | negative
  replyDraft String?
  replied    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([source, externalId])
  @@index([postedAt])
}

/// Weekly targets; weekStart is a Monday.
model Budget {
  weekStart   DateTime @id @db.Date
  sales       Decimal? @db.Decimal(12, 2)
  foodCostPct Decimal? @db.Decimal(5, 4)
  laborPct    Decimal? @db.Decimal(5, 4)
}
